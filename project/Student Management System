select s.student_id,s.name,d.department_name from students s join departments d on s.department_id=d.department_id;

select s.name as student_name,c.course_name,m.marks
 from marks m join students s 
 on m.student_id=s.student_id join courses c 
 on m.course_id=c.course_id;
 
 
 select 
 s.name as student_name,
 c.course_name,
 t.teacher_name,
 e.exam_name,
 m.marks
 from marks m join students s
 on m.student_id=s.student_id
 join courses c on m.course_id=c.course_id 
 join departments d
 on s.department_id=d.department_id
 join teachers t
 on c.teacher_id=t.teacher_id
 join exams e 
 on m.exam_id=e.exam_id;
 
