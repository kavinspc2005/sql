 select s.name as student_name,
 avg(m.marks) as average_marks
 from marks m
 join students s
 on m.student_id=s.student_id
 group by s.name;
 
 
 select s.name as student_name,
 max(m.marks)as average_marks
 from marks m
 join students s 
 on m.student_id=s.student_id
 group by s.name;
 
 
 select s.name as student_name,
 min(m.marks)as lowest_marks
 from marks m
 join students s on 
 m.student_id=s.student_id
 group by s.name;
 
 
SELECT 
    d.department_name,
    COUNT(s.student_id) AS total_students
FROM students s
JOIN departments d
ON s.department_id = d.department_id
GROUP BY d.department_name;
 
